# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# HackerOne (https://api.hackerone.com/getting-started-hacker-api/)
H1_USERNAME=
H1_API_TOKEN=

# Bugcrowd (https://docs.bugcrowd.com/api/)
BUGCROWD_TOKEN=

# YesWeHack (https://api.yeswehack.com/doc)
YESWEHACK_TOKEN=
YESWEHACK_TOTP_SECRET=

# Polling
POLL_INTERVAL_MINUTES=30
# Comma-separated: hackerone,bugcrowd,yeswehack
ENABLED_PLATFORMS=hackerone,bugcrowd,yeswehack

# Storage (10 GiB hard cap on SQLite)
DB_PATH=data/bugcontrol.db
DB_MAX_BYTES=10737418240
DB_SOFT_LIMIT_BYTES=8589934592
ARTIFACT_DIR=data/artifacts
ARTIFACT_MAX_BYTES_PER_JOB=52428800

# Scanners
SCAN_CONCURRENCY=2
SCAN_TIMEOUT_SECONDS=1800
SECRETS_SCANNER=gitleaks
NMAP_BIN=nmap
SQLMAP_BIN=sqlmap
NIKTO_BIN=nikto
NUCLEI_BIN=nuclei
GITLEAKS_BIN=gitleaks
TRUFFLEHOG_BIN=trufflehog

# Cursor cloud agents
CURSOR_API_KEY=
CURSOR_AGENT_REPO=
CURSOR_MODEL=composer-2.5
CURSOR_AGENT_REF=main

# Logging
LOG_LEVEL=INFO
